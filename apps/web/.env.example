# Mẫu các giá trị môi trường setup cho .env.local
VITE_API_URL=https://<your-api-id>.execute-api.<your-region>.amazonaws.com/<your-stage>
VITE_COGNITO_REGION=<your-region>
VITE_COGNITO_USER_POOL_ID=<your-user-pool-id>
VITE_COGNITO_CLIENT_ID=<your-client-id>
VITE_MERCHANT_API_KEY=<your-merchant-api-key>